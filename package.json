{
  "name": "cape-hydraulics",
  "version": "1.0.0",
  "description": "HydroStick — a Pipe-Flo-style pipe network and surge (waterhammer) modeler that runs entirely in the browser.",
  "scripts": {
    "test": "node test/test.js",
    "serve": "node -e \"const h=require('http'),f=require('fs'),p=require('path'),P=8000;const t={'.html':'text/html','.css':'text/css','.js':'text/javascript','.json':'application/json'};h.createServer((q,s)=>{let u=decodeURI(q.url.split('?')[0]);if(u==='/')u='/index.html';const fp=p.join(process.cwd(),u);f.readFile(fp,(e,d)=>{if(e){s.writeCode=404;s.statusCode=404;return s.end('not found');}s.setHeader('Content-Type',t[p.extname(fp)]||'application/octet-stream');s.end(d);});}).listen(P,()=>console.log('HydroStick on http://localhost:'+P));\""
  },
  "keywords": [
    "hydraulics",
    "pipe-flow",
    "waterhammer",
    "surge",
    "darcy-weisbach",
    "moc"
  ],
  "license": "MIT",
  "devDependencies": {
    "canvas": "^3.2.3",
    "jsdom": "^29.1.1",
    "puppeteer": "^25.1.0"
  }
}
